# Supabase — copy from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Admin credentials — set these to whatever you want
ADMIN_EMAIL=admin@bookease.com
ADMIN_PASSWORD=change_this_to_a_strong_password

# Secret used to sign the admin session cookie
# Generate with: openssl rand -hex 32
ADMIN_SECRET=generate_a_random_32_char_secret_here
